# Reverse-Proxy mit automatischem HTTPS (Let's Encrypt) für paloskin.de auf dem Hetzner-Server.
# Caddy holt und erneuert die Zertifikate selbst, sobald die DNS-Einträge auf den Server zeigen.
# Die Sicherheitsheader (CSP, X-Content-Type-Options, X-Frame-Options, Referrer-Policy) setzt die Anwendung selbst
# (next.config.ts), damit sie an einer Stelle stehen. HSTS kommt erst hier, nach geprüftem HTTPS.
# Kein HTTP/3 (UDP 443 ist in der Hetzner-Firewall nicht offen); nur HTTP/1.1 und HTTP/2.
{
	servers {
		protocols h1 h2
	}
	# Verbindungen ohne Servernamen (Aufruf über die Adresse 10.0.0.2 im privaten Netz) bekommen das Zertifikat für 10.0.0.2
	fallback_sni 10.0.0.2
}

(paloskin) {
	encode zstd gzip
	# Der Endpunkt für das Kundensystem existiert öffentlich nicht (nur im privaten Netz, Block unten)
	@intern path /intern/*
	respond @intern 404
	reverse_proxy {args[0]} {
		# Nur Caddy setzt diese Kopfzeilen; die App vertraut X-Forwarded-For und X-Forwarded-Proto deshalb nur dem Proxy
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up -X-Palo-Intern
	}
	header {
		# Erst aktivieren, wenn HTTPS auf www und apex nachweislich läuft (Zertifikat, Weiterleitung, alle Seiten):
		# Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output file /var/log/caddy/paloskin.log {
			roll_size 10mb
			roll_keep 5
			# Zugriffsprotokolle mit IP-Adresse höchstens 14 Tage (Datenschutzerklärung Ziffer 2)
			roll_keep_for 336h
		}
		format json
	}
}

# Vorübergehende Weiterleitungen (302) auf paloskin.de, www und neu, je mit und ohne Schrägstrich am Ende:
# Wallet-Pass (Auftrag Dr. Vogel, 10. Oktober 2026): /wallet und /wallet/ leiten auf den Pass weiter.
# Absichtlich nirgends verlinkt und nicht in der Sitemap; Dr. Vogel gibt die Adresse nur auf Nachfrage weiter.
# Das Ziel bei Bedarf hier ändern (siehe CLAUDE.md). 302, damit Browser die Weiterleitung nicht dauerhaft speichern.
(wallet) {
	@wallet path /wallet /wallet/
	redir @wallet https://pass.walletwallet.dev/p/bfdfdded-f6a9-4b8b-97cf-1d2c1bd106f3 302
	# Einladung zur Eröffnung am 24. Oktober 2026 (Auftrag Dr. Vogel, 10. Oktober 2026): /oysters und /oysters/, 302,
	# unverlinkt; nach dem Event wieder entfernen.
	@oysters path /oysters /oysters/
	redir @oysters https://oysters-and-botox.netlify.app 302
}

# Testname: zeigt auf die Testinstanz app-test (Profil test), nicht auf die laufende Seite.
neu.paloskin.de {
	import wallet
	import paloskin app-test:3000
}

paloskin.de {
	# /wallet zuerst (302 direkt zum Pass), alles andere wie bisher dauerhaft auf www
	import wallet
	handle {
		redir https://www.paloskin.de{uri} permanent
	}
}

www.paloskin.de {
	import wallet
	import paloskin app:3000
}

# Endpunkt für das Kundensystem (Stufe 2, Schritt 3): nur im privaten Hetzner-Netz paloskin-intern erreichbar.
# Caddy veröffentlicht 8443 ausschließlich an 10.0.0.2 (Compose), Zertifikat von Caddys interner Zertifizierungsstelle
# für die Adresse 10.0.0.2 und den Namen buchung.intern; das Wurzelzertifikat bekommt das Kundensystem (Anleitung 18).
# Ziel über INTERN_UPSTREAM (Compose: PALOSKIN_INTERN_UPSTREAM, Standard app:3000; zum Testen app-test:3000).
https://10.0.0.2:8443, https://buchung.intern:8443 {
	tls internal
	@intern path /intern/*
	handle @intern {
		reverse_proxy {$INTERN_UPSTREAM:app:3000} {
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Palo-Intern 1
		}
	}
	handle {
		respond 404
	}
	header -Server
	log {
		output file /var/log/caddy/intern.log {
			roll_size 10mb
			roll_keep 5
			roll_keep_for 336h
		}
		format json
	}
}
