# Umgebungsvariablen für den Server, Ablage zum Beispiel unter /etc/paloskin/paloskin.env (chmod 600, root).
# Werte aus Vercel beziehungsweise aus .env.local übernehmen. Nie ins Repository.

# Betrieb
BOOKING_ENGINE=google
TEST_MODE=true
TEST_ACCESS_CODE=
SLOT_STEP_MINUTES=30
BUFFER_MINUTES=0

