# Umgebungsvariablen für den Server, Ablage unter /etc/paloskin/paloskin.env (root, chmod 600). Nie ins Repository.
# Der Dienstkontoschlüssel liegt NICHT hier, sondern als Datei /etc/paloskin/service-account.json (root, chmod 600),
# die Compose als Secret einbindet; die App bekommt nur den Pfad (GOOGLE_SERVICE_ACCOUNT_FILE, gesetzt in docker-compose.yml).

# Buchungsmotor und Testbetrieb
BOOKING_ENGINE=google
TEST_MODE=true
TEST_ACCESS_CODE=
SLOT_STEP_MINUTES=30
BUFFER_MINUTES=0

# Kalender
CALENDAR_OPEN_ID=c_0dd32d23bbc720070e8345e963bb958d496c786c4a26d4c49375254276403943@group.calendar.google.com
CALENDAR_BOOKINGS_ID=c_5c073fe9d8b5b448d61cba6ab7573c5f61a7fc012d969ff103a6a91f7c2d17ad@group.calendar.google.com
CALENDAR_BUSY_IDS=sebastian@paloskin.de,c_5c073fe9d8b5b448d61cba6ab7573c5f61a7fc012d969ff103a6a91f7c2d17ad@group.calendar.google.com

# Vertrauenswürdiger Proxy: nur Caddy setzt X-Forwarded-For
TRUST_PROXY=true

# Freiwillig: Meldung unklarer Buchungsausgänge per POST (ohne personenbezogene Daten)
OWNER_WEBHOOK_URL=
