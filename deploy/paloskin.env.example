# Umgebungsvariablen für den Server, Ablage unter /etc/paloskin/paloskin.env (root, chmod 600). Nie ins Repository.
# Der Dienstkontoschlüssel liegt NICHT hier, sondern als Datei /etc/paloskin/service-account.json
# (Eigentümer 10001:10001, Rechte 0400), die Compose als Secret einbindet; die App bekommt nur den Pfad.

# Buchungsmotor und Testbetrieb (ohne TEST_MODE gilt Produktion; die Testinstanz setzt TEST_MODE=true über Compose)
BOOKING_ENGINE=google
TEST_MODE=false
TEST_ACCESS_CODE=
# Signaturschlüssel für das Zugangs-Cookie (lang, zufällig; Wechsel widerruft alle Cookies)
TEST_COOKIE_SECRET=
SLOT_STEP_MINUTES=30
BUFFER_MINUTES=0

# Kalender
CALENDAR_OPEN_ID=c_0dd32d23bbc720070e8345e963bb958d496c786c4a26d4c49375254276403943@group.calendar.google.com
CALENDAR_BOOKINGS_ID=c_5c073fe9d8b5b448d61cba6ab7573c5f61a7fc012d969ff103a6a91f7c2d17ad@group.calendar.google.com
CALENDAR_BUSY_IDS=sebastian@paloskin.de,c_5c073fe9d8b5b448d61cba6ab7573c5f61a7fc012d969ff103a6a91f7c2d17ad@group.calendar.google.com

# Buchungsdatenbank (Stufe 2): Pfad setzt die Compose-Datei (/var/lib/paloskin/buchung.sqlite); hier nichts eintragen.
# Verbindliche Buchung statt Terminanfrage: erst nach der Abnahme von Stufe 2 auf true
BOOKING_BINDING=false

# Bestätigungsmail über den SMTP-Relay von Google Workspace (Server-Adresse ist in der Admin-Konsole freigegeben, kein Passwort).
# Achtung: der Host heißt smtp-relay.gmail.com, nicht smtp-relay.google.com. MAIL_MODE leer heißt relay, sobald der Host gesetzt ist.
MAIL_RELAY_HOST=smtp-relay.gmail.com
MAIL_RELAY_PORT=587
MAIL_FROM=bookings@paloskin.de
MAIL_FROM_NAME=PALO SKIN by Dr. Vogel
MAIL_REPLY_TO=bookings@paloskin.de
# Signaturschlüssel der Terminlinks in den Mails (lang, zufällig; Wechsel macht alle verschickten Links ungültig)
LINK_SECRET=
# Tägliche Handliste der WhatsApp-Erinnerungen (18:00 Uhr Berliner Zeit) an diese Adresse; leer heißt keine Liste
OWNER_MAIL=
# Bearer-Token des Endpunkts für das Kundensystem (32 Byte zufällig, nur im Terminal erzeugen; leer heißt Endpunkt aus)
INTERN_TOKEN=

# Vertrauenswürdiger Proxy: nur Caddy setzt X-Forwarded-For und X-Forwarded-Proto
TRUST_PROXY=true

# Freiwillig: Meldung unklarer Buchungsausgänge per POST (ohne personenbezogene Daten)
OWNER_WEBHOOK_URL=
