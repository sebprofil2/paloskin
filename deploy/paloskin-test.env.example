# Umgebungswerte der Testinstanz (neu.paloskin.de). Auf dem Server: /etc/paloskin/paloskin-test.env, Rechte 0600.
# Nie die Datei der Produktion verwenden. Werte ohne Anführungszeichen, keine Geheimnisse ins Repository.
#
# Kalender: nur der Testkalender „Palo Skin Test“ (Kalender-ID aus den Google-Kalendereinstellungen, Abschnitt „Kalender integrieren“).
# Er dient zugleich als Fenster und als Buchungskalender: Öffnungsfenster sind Einträge mit „Verfügbar“ (frei),
# Buchungen schreibt die Instanz als „Beschäftigt“. Solange er fehlt: BOOKING_ENGINE=mock (erfundene Zeiten, kein Google).
BOOKING_ENGINE=mock
TEST_CALENDAR_ID=
#
# Mail: alles an diese Adresse, Betreff mit [TEST]. Ohne MAIL_REDIRECT_TO sendet die Instanz nichts und bucht nicht.
MAIL_MODE=relay
MAIL_RELAY_HOST=smtp-relay.gmail.com
MAIL_RELAY_PORT=587
MAIL_FROM=bookings@paloskin.de
MAIL_FROM_NAME=PALO SKIN by Dr. Vogel
MAIL_REPLY_TO=bookings@paloskin.de
MAIL_REDIRECT_TO=
OWNER_MAIL=
#
# Zugang und Links (Werte nur auf dem Server)
TEST_ACCESS_CODE=
TEST_COOKIE_SECRET=
LINK_SECRET=
BOOKING_BINDING=true
SLOT_STEP_MINUTES=
BUFFER_MINUTES=
TRUST_PROXY=true
