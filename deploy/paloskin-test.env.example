# Umgebungswerte der Testinstanz (neu.paloskin.de). Auf dem Server: /etc/paloskin/paloskin-test.env, Rechte 0600.
# Nie die Datei der Produktion verwenden. Werte ohne Anführungszeichen, keine Geheimnisse ins Repository.
#
# Kalender: Belegung und Buchungen nur im Testkalender „PALO SKIN Test“ (Kalender-ID aus den Google-Kalendereinstellungen,
# Abschnitt „Kalender integrieren“). Öffnungsfenster aus TEST_OPEN_CALENDAR_ID, seit 4. Oktober 2026 der echte Kalender
# „PALO SKIN offen“ (Dienstkonto nur mit Leserechten), damit neu dieselben Zeiten zeigt wie www. Ohne TEST_OPEN_CALENDAR_ID
# zählen wie früher die als „Verfügbar“ markierten Einträge im Testkalender. Solange TEST_CALENDAR_ID fehlt: BOOKING_ENGINE=mock.
BOOKING_ENGINE=mock
TEST_CALENDAR_ID=
TEST_OPEN_CALENDAR_ID=
#
# Mail: alles an diese Adresse, Betreff mit [TEST]. Ohne MAIL_REDIRECT_TO sendet die Instanz nichts und bucht nicht.
MAIL_MODE=relay
MAIL_RELAY_HOST=smtp-relay.gmail.com
MAIL_RELAY_PORT=587
MAIL_FROM=bookings@paloskin.de
MAIL_FROM_NAME=PALO SKIN by Dr. Vogel
MAIL_REPLY_TO=bookings@paloskin.de
MAIL_REDIRECT_TO=
OWNER_MAIL=
#
# Zugang und Links (Werte nur auf dem Server)
TEST_ACCESS_CODE=
TEST_COOKIE_SECRET=
LINK_SECRET=
BOOKING_BINDING=true
SLOT_STEP_MINUTES=
BUFFER_MINUTES=
TRUST_PROXY=true
