# Buchungsmotor: mock (erfundene freie Zeiten, nichts wird in Google eingetragen) oder google
BOOKING_ENGINE=mock

# Testbetrieb (Standard, solange nicht TEST_MODE=false): Zugang zu /booking nur mit ?test=<TEST_ACCESS_CODE>, Einträge mit „TEST “ im Titel.
# Ohne gültigen Code zeigt /booking die Zwischenlösung (Anfrage per WhatsApp).
TEST_MODE=true
TEST_ACCESS_CODE=bitte-eigenen-code-setzen
# Signaturschlüssel für das Zugangs-Cookie (lang, zufällig). Wechsel macht alle Cookies ungültig. Leer: aus dem Testcode abgeleitet.
TEST_COOKIE_SECRET=

# Raster und Puffer in Minuten
SLOT_STEP_MINUTES=30
BUFFER_MINUTES=0

# Google Calendar API, Dienstkonto (nur für BOOKING_ENGINE=google)
# Entweder die komplette Schlüsseldatei als eine Zeile JSON in einfachen Anführungszeichen ...
GOOGLE_SERVICE_ACCOUNT_JSON=
# ... oder getrennt: E-Mail des Dienstkontos und privater Schlüssel (\n als Zeilenumbruch oder mehrzeilig in Anführungszeichen)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Kalender „Palo Skin offen“ (Dienstkonto: Termine lesen, alle Details)
CALENDAR_OPEN_ID=
# Kalender „Palo Skin Termine“ (Dienstkonto: Termine lesen und ändern)
CALENDAR_BOOKINGS_ID=
# Kommagetrennt, nur frei/belegt: mindestens Hauptkalender und „Palo Skin Termine“
CALENDAR_BUSY_IDS=

# Nur für den Testmotor: true simuliert einen Ausfall („Die freien Termine laden gerade nicht“)
BOOKING_MOCK_DOWN=false

# Freiwillig: Adresse, an die unklare Buchungsausgänge als JSON gemeldet werden (POST)
OWNER_WEBHOOK_URL=

# Buchungsdatenbank (SQLite, Stufe 2). Lokal reicht der Standard .data/buchung.sqlite (nicht im Repository)
BOOKING_DB_PATH=
# Verbindliche Buchung (confirmed) statt Terminanfrage (requested); nur nach Abnahme von Stufe 2
BOOKING_BINDING=false

# Mails: lokal MAIL_MODE=file (Dateien unter .data/mail), auf dem Server relay über smtp-relay.gmail.com ohne Anmeldung
MAIL_MODE=file
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_FROM=bookings@paloskin.de
MAIL_REPLY_TO=info@paloskin.de
# Öffentliche Adresse für die Links in den Mails
PUBLIC_BASE_URL=http://localhost:3000
LINK_SECRET=

# X-Forwarded-For nur vom eigenen Proxy übernehmen (hinter Caddy auf dem Server true; auf Vercel nicht nötig)
TRUST_PROXY=false
